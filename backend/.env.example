# --- Serveur ---
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# --- Base de données (Railway/Render fournissent cette URL automatiquement) ---
DATABASE_URL="postgresql://user:password@localhost:5432/bookverse?schema=public"

# --- JWT (générer avec: openssl rand -base64 64) ---
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- Stripe (https://dashboard.stripe.com/apikeys) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- PayPal (https://developer.paypal.com/dashboard/applications) ---
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_ENV=sandbox
PAYPAL_FCFA_TO_USD_RATE=0.0016

# --- Orange Money (https://developer.orange.com/apis/om-webpay) ---
# Nécessite un compte marchand Orange Money Cameroun.
ORANGE_MONEY_API_BASE_URL="https://api.orange.com"
ORANGE_MONEY_CLIENT_ID=""
ORANGE_MONEY_CLIENT_SECRET=""
ORANGE_MONEY_MERCHANT_KEY=""

# --- MTN MoMo (https://momodeveloper.mtn.com) ---
# Nécessite un compte développeur MTN + abonnement "Collections".
MTN_MOMO_API_BASE_URL="https://sandbox.momodeveloper.mtn.com"
MTN_MOMO_SUBSCRIPTION_KEY=""
MTN_MOMO_API_USER=""
MTN_MOMO_API_KEY=""
MTN_MOMO_TARGET_ENV=sandbox

# --- Google Gemini (fonctionnalités IA : résumé, assistant de lecture, recommandations) ---
# https://aistudio.google.com/apikey
GEMINI_API_KEY=""
